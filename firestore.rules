rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /photos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "rj.shaheen03@gmail.com";
    }

    match /sections/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "rj.shaheen03@gmail.com";
    }

  }
}
